# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM provider for the pipeline (skills/lib/llm.py). Default: anthropic.
# Swap per-run instead with --provider / --llm-model flags on a skill's CLI.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5

# Required for the default provider — used by skills/ingest/ingest.py etc.
# for insight extraction.
ANTHROPIC_API_KEY=

# Required only if LLM_PROVIDER=openrouter (open-weight model comparisons,
# BUILD.md post-launch backlog — not the daily pipeline).
# OPENROUTER_API_KEY=

# brain@ mailbox polling for email-only sources (skills/ingest/ingest.py's
# fetch_entries_email(), open decision #7a). Code is real as of 2026-08-12;
# see BUILD.md's brain@ Gmail walkthrough for how to get these three, and
# skills/lib/gmail_get_refresh_token.py for the one-time refresh-token step.
# ask@ lane (MAINTAINER.md rule 5, D8) reuses the same credentials, not built yet.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Podcast transcription (skills/lib/transcribe.py, planned —
# docs/full-source-text-ingestion.md). OpenAI Whisper API is the first
# provider; not yet built.
# OPENAI_API_KEY=

# X home-timeline ingestion (skills/ingest/ingest.py's planned
# fetch_entries_x() — docs/full-source-text-ingestion.md). Client
# ID/Secret come from the brianmaddenai account's X Developer Portal app;
# Access/Refresh Token require completing OAuth 2.0 user-context
# authorization for that same account (see the doc — likely a short
# follow-up step, not just a portal copy-paste).
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_ACCESS_TOKEN=
# X_REFRESH_TOKEN=
