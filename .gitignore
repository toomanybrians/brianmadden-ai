# Copy-paste renderings of published drafts (skills/brief/render.py) —
# a convenience for pasting into Substack's rich-text editor, not repo
# content. The committed .md is the source of truth.
outputs/published/**/*.html

# Same convenience rendering for pages/ (skills/pages/render.py).
pages/*.html

# Same convenience rendering for the Weekly Update (skills/weekly/render.py).
outputs/weekly-updates/**/*.html

# Same convenience rendering for podcast episodes (scripts/render_substack_html.py).
outputs/podcast/**/*.html

# Same convenience rendering for one-off talk/post Substack drafts — the
# canon file (talks/, posts/, frameworks/) is the source of truth, and the
# Substack post itself is the published copy. No HTML lives in this repo.
outputs/substack-migration/**/*.html
